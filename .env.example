# Asteric environment variables.
# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# ---- Required -------------------------------------------------------------
# Postgres connection string (Neon, Supabase, RDS, ...). Use the pooled URL with sslmode=require.
DATABASE_URL=postgres://user:password@host:5432/asteric?sslmode=require
# Public base URL of the deployment, no trailing slash. Used in invitation and reset links.
APP_URL=https://app.yourdomain.com
# 32 random bytes, base64. Encrypts two-factor secrets and keys IP hashing.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later invalidates enrolled two-factor devices.
APP_ENCRYPTION_KEY=
# Random string Vercel Cron sends to /api/cron/daily. Generate like the key above.
CRON_SECRET=

# ---- First-run administrator ---------------------------------------------
# Open /signup?setup=<SETUP_TOKEN> with an email listed below to create the platform
# administrator account. Remove SETUP_TOKEN afterwards.
SETUP_TOKEN=
PLATFORM_ADMIN_EMAILS=you@yourdomain.com

# ---- Access ----------------------------------------------------------------
# invite_only (default): firms are provisioned from /admin. open: anyone can create a workspace.
SIGNUP_MODE=invite_only
# enabled: the login page offers the synthetic demonstration workspace.
DEMO_MODE=enabled
# Optional: require this code to enter the demo (share it with investors).
DEMO_ACCESS_CODE=

# ---- Email (optional but recommended) -----------------------------------
# Without these, invitation and reset links are shown on screen to administrators instead of emailed.
RESEND_API_KEY=
EMAIL_FROM=Asteric <no-reply@yourdomain.com>

# ---- AI-assisted import mapping (optional, off by default) -------------
# Only column headers and inferred value types are sent; organizations must also opt in.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# A current Claude model ID from Anthropic's documentation.
AI_MODEL=

# ---- Public site details (shown on legal and contact pages) -------------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SECURITY_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY=Asteric
NEXT_PUBLIC_GOVERNING_LAW=

# ---- Tuning (defaults shown) --------------------------------------------
# SESSION_IDLE_HOURS=12
# SESSION_ABSOLUTE_DAYS=14
# DB_POOL_MAX=5
# DB_TENANT_ROLE=asteric_app
